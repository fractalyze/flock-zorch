load("@flock_zorch_pip//:requirements.bzl", "requirement")
load("@rules_python//python:defs.bzl", "py_library", "py_test")

py_library(
    name = "flock_zorch",
    srcs = glob(
        ["flock_zorch/**/*.py"],
        exclude = ["flock_zorch/**/testing/**"],
    ),
    imports = ["."],
    visibility = ["//visibility:public"],
    deps = [
        "@zorch//zorch:blake3_field_transcript",
        "@zorch//zorch:byte_transcript",
        "@zorch//zorch:prove",
        "@zorch//zorch:round",
        "@zorch//zorch:sha256_field_transcript",
        "@zorch//zorch/sumcheck",
        "@zorch//zorch/coding:reed_solomon",
        "@zorch//zorch/commit:merkle",
        "@zorch//zorch/pcs:fold",
        "@zorch//zorch/pcs:ring_switch",
        "@zorch//zorch/pcs/ligerito",
        "@zorch//zorch/poly",
        "@zorch//zorch/utils:binary_field",
        # zorch.utils.binary_field imports frx's pallas at module scope, whose
        # mosaic-gpu chain does `from absl import logging`; the frx wheel does
        # not declare absl-py, so the hermetic env must.
        requirement("absl-py"),
        requirement("frx"),
        requirement("hash_frx"),
        requirement("numpy"),
        requirement("zk_dtypes"),
    ],
)

py_library(
    name = "test_support",
    # Glob, not a list: every shared testing helper must land here or the
    # py_tests fail at import, and an explicit list makes that easy to forget.
    # The pattern already covers __init__.py, which is why naming it as well
    # would duplicate the label.
    srcs = glob(["flock_zorch/testing/_*.py"]),
    imports = ["."],
    visibility = ["//visibility:public"],
    deps = [
        ":flock_zorch",
        requirement("frx"),
        requirement("numpy"),
    ],
)

# The one flock byte-match gate CPU CI can run. The proof-level gates (identity
# e2e + hash circuits under flock_zorch/testing/) need a GPU and run on the venv;
# flock's fused prove has no registered Ligerito config below m=22, so a small-m
# e2e CPU gate is not dumpable — this full-LigeritoProof gate anchors CI instead.
py_test(
    name = "ligerito_oracle_test",
    size = "medium",  # ~64s on CPU
    srcs = ["flock_zorch/pcs/testing/ligerito_oracle_test.py"],
    data = ["//artifacts:goldens"],
    deps = [
        ":flock_zorch",
        ":test_support",
    ],
)

# No golden: FlockTranscript/FlockChoreography framing lockstep vs the
# Sha256Challenger surface + a zorch-driver Ligerito round trip over the GHASH
# code, all-CPU.
py_test(
    name = "zorch_ligerito_fs_test",
    size = "medium",
    srcs = ["flock_zorch/pcs/testing/zorch_ligerito_fs_test.py"],
    deps = [
        ":flock_zorch",
        ":test_support",
    ],
)

# Fork-fixture byte gate for the benchmark profile's BLAKE3 Fiat-Shamir arm:
# every draw and grind nonce vs transcripts dumped from flock-challenge's own
# FsChallenger, plus the existing SHA-256 challenger as the sequence control.
# "medium", not "small": the fixtures drive the DEVICE transcript, whose two
# grinds trace a while loop over a 4096-wide compression apiece. That is real
# device work where the retired host arm only ran numpy, and it overran the
# 60s small budget on CI.
py_test(
    name = "blake3_challenger_test",
    size = "medium",
    srcs = ["flock_zorch/testing/blake3_challenger_test.py"],
    deps = [
        ":flock_zorch",
    ],
)

# No target for the BLAKE3 hasher state or the device transcript's framing:
# both modules live upstream now (hash-frx's `blake3/streaming.py`, zorch's
# `blake3_field_transcript.py`) and are gated there against their own oracles.
# What stays below is only what upstream has no way to check — how THIS repo
# uses them.

# The two checks that are flock's rather than the transcript's: the Fiat-Shamir
# round loop staying inside the compiled program (the leading indicator for a
# transcript that stopped being a loop carry), and what BLAKE3_PROFILE is
# composed of. The framing, scalar-vs-slice and grind halves moved upstream with
# the module.
py_test(
    name = "blake3_field_transcript_test",
    size = "medium",
    srcs = ["flock_zorch/testing/blake3_field_transcript_test.py"],
    deps = [
        ":flock_zorch",
    ],
)

# `--hash` must select a whole arm and name it in the output: a wall-clock
# number from this harness means nothing without knowing which Fiat-Shamir and
# Merkle hashes produced it, and one attributed to the wrong arm survives into an
# issue. Pure host wiring, no golden and no device.
py_test(
    name = "prove_phase_bench_test",
    size = "small",
    # The harness itself rides in srcs: it is a script, so no library carries it
    # (`py_library` excludes testing/, `test_support` globs only `_*.py`).
    srcs = [
        "flock_zorch/testing/prove_phase_bench.py",
        "flock_zorch/testing/prove_phase_bench_test.py",
    ],
    main = "flock_zorch/testing/prove_phase_bench_test.py",
    deps = [
        ":flock_zorch",
        ":test_support",
    ],
)

