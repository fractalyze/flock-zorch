# flock-zorch runtime dependencies.
#
# Pulled from the Fractalyze package index alongside upstream PyPI:
#   pip install -r requirements.in \
#     --extra-index-url https://fractalyze.github.io/pypi/simple/
#
# flock-zorch is the flock-specific consumer of zorch's agnostic blocks; zorch
# itself arrives as a Bazel module (see MODULE.bazel), not a pip dep.
absl-py
numpy
# PEP 696 TypeVar defaults, which `typing` gains only in 3.13. zorch subscripts
# them in base-class position, so it is a runtime import, not TYPE_CHECKING-only.
typing-extensions
# The four frx pins move in lockstep with the zorch `git_override` pin in
# MODULE.bazel, and must name the SAME version as zorch's own requirements.in:
# the binary-field GPU kernels have to match, and CPU-only CI cannot catch a
# desync. frx/frxlib are the Fractalyze jax_fork rebrand. What a particular
# wheel carries belongs in the bump commit that moved these pins, not here.
frx==0.10.2.dev20260910150749
frxlib==0.10.2.dev20260910150749
frx-cuda12-plugin==0.10.2.dev20260910150749
frx-cuda12-pjrt==0.10.2.dev20260910150749
# zk_dtypes ships the native field dtypes frx lowers; arrives transitively via
# frx but the resolver lags, so pin it so the lock tracks the frx wheel.
# 0.0.10 adds the flat AES-basis binary_field_gf8_aes dtype (zk_dtypes#157);
# 0.0.15 is the floor of the frx wheel above (it registers the
# classical-curve field dtypes). 0.0.17 is the floor of the wheel pinned here —
# it registers the ed25519 twisted-Edwards G1 point dtypes, so it resolves
# `zk_dtypes.ed25519_g1_affine`, absent before 0.0.17. An older pin still
# resolves and then fails at import, so this moves with the frx quad, and it is
# zorch's lockstep pin.
zk-dtypes==0.0.17

# The symmetric layer (SHA-256, permutations, sponges) and the `fused_region`
# marker seam. It sits BELOW `zorch`, which imports it rather than owning a
# copy, so this repo takes it directly — pip resolves here on a separate hub
# from zorch's, so a shared distribution has to be named in both.
hash-frx==0.2.0.dev20260911005315
# TEST-ONLY, and formerly transitive: every row hash-frx ships is now a device
# row, so a host BLAKE3 digest is the caller's to make. `zorch.testkit.byte_hash`
# makes it for both repos and reaches this binding by plain `import blake3`, so
# the venv the GPU gates run on has to carry it. The bazel tests take it from
# `@zorch_pip` through `//zorch/testkit:byte_hash`; unpinned here, as in zorch's
# own `requirements.in`, because a stable third-party binding of a published
# standard is not the kind of shared distribution a hub skew can break.
blake3
